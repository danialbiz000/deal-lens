# Copy this file to apps/api/.env before running the API (pydantic-settings
# reads .env relative to the process's working directory, i.e. apps/api).

# --- apps/api ---

DATABASE_URL=sqlite:///./deal_lens.db

# SEC EDGAR requires a descriptive User-Agent identifying the app + a
# contact email (https://www.sec.gov/os/webmaster-faq#developers). Requests
# without one get throttled/blocked. Replace the email below with yours.
EDGAR_USER_AGENT="DealLens Portfolio Project (you@example.com)"

# Financial Modeling Prep free-tier API key:
# https://site.financialmodelingprep.com/developer/docs
# Optional -- ingestion still works with SEC EDGAR alone if this is blank,
# just without the supplementary backfill (shares_outstanding, a clean
# EBITDA figure, cross-checks).
FMP_API_KEY=

# Phase 4 AI layer (memo writer + IC simulator) -- required ONLY for
# POST /companies/{id}/memo and POST /companies/{id}/ic-simulation, and
# only when you want them to actually run. Every other endpoint in this
# project, including the default test suite, needs neither of these.
# Get a key at https://console.anthropic.com/
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5

# Rate limiting (cost control on the 3 paid-Claude-API endpoints, plus
# good-citizenship throttling on /ingest towards SEC EDGAR/FMP) -- added
# once a real ANTHROPIC_API_KEY was configured and the repo went public.
# Values use the `limits` package's own string syntax, e.g. "5/hour;20/day"
# for multiple stacked windows. Set RATE_LIMIT_ENABLED=false for local dev
# convenience without touching code; the test suite always runs with it
# false regardless of this file (set directly in tests/conftest.py).
RATE_LIMIT_ENABLED=true
RATE_LIMIT_AI_PER_IP=10/minute
RATE_LIMIT_AI_PER_COMPANY="5/hour;20/day"
RATE_LIMIT_EXTRACTION_PER_COMPANY="5/hour;15/day"
RATE_LIMIT_INGEST_PER_IP=20/minute
RATE_LIMIT_INGEST_PER_COMPANY=10/hour

# --- apps/web ---
# Copy this line into apps/web/.env.local instead (Next.js reads
# NEXT_PUBLIC_* vars from .env.local, not from apps/api's .env).
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
